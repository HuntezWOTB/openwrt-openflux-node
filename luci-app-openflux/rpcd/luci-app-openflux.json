{
	"luci-app-openflux": {
		"description": "Grant UCI and backend access for luci-app-openflux",
		"read": {
			"uci": ["openflux"],
			"ubus": {
				"service": ["list"],
				"luci.openflux": ["getStatus", "getLog", "getSecret"]
			}
		},
		"write": {
			"uci": ["openflux"],
			"ubus": {
				"luci.openflux": ["setAction", "setSecret", "wipeDoc"]
			}
		}
	}
}
