config openflux 'main'
  option enabled '1'
  option mode 'l4'
  option transport 'mailru'
  option url 'https://cloud.mail.ru/public/XXXX/YYYY'
  option transports ''
  option negotiate '1'
  option debug '1'
  option encryption_key_file '/etc/openflux/secret.txt'
  option cookie_store '/tmp/cookies-yandex.json'
  option cookies_paste ''
