#!/bin/sh /etc/rc.common
# OpenFlux: домашний роутер как выходная нода, управление через Службы -> OpenFlux (UCI).
# Нода сама подключается наружу к общему документу, входящих портов не открывает.
START=99
STOP=10
USE_PROCD=1

BIN=/usr/bin/openflux

# openflux_write_cookies <url> <cookie_file> <paste>
# Пастит куки из LuCI в store формата {"<url>": {name: value}}.
openflux_write_cookies() {
  local url="$1" cfile="$2" paste="$3"
  local tmp="${cfile}.tmp" pairs="" line name value
  [ -n "$url" ] && [ -n "$cfile" ] && [ -n "$paste" ] || return 1
  # JSON-объект {"a":"b"} -> обернуть под URL через awk (без jq на роутере).
  case "$paste" in
    \{*)
      # грубая проверка что это объект; кавычки/бэкслэши внутри значений не поддержим
      printf '{"%s": %s}\n' "$(printf '%s' "$url" | sed 's/\\/\\\\/g; s/"/\\"/g')" "$paste" > "$tmp" && \
        mv "$tmp" "$cfile" && chmod 600 "$cfile" && return 0
      return 1
      ;;
  esac
  # Иначе собираем пары name=value из: Netscape-строк, "a=b; c=d", построчных a=b.
  pairs="$(printf '%s' "$paste" | awk '
    function emit(n, v) {
      gsub(/\\/,"\\\\",n); gsub(/"/,"\\\"",n);
      gsub(/\\/,"\\\\",v); gsub(/"/,"\\\"",v);
      if (n != "" ) printf "\"%s\":\"%s\",", n, v
    }
    {
      line=$0; sub(/^[ \t\r]+/,"",line); sub(/[ \t\r]+$/,"",line);
      if (line=="" || line ~ /^#/) next;
      if (NF>=7 && $0 ~ /\t/) { # Netscape: ... name value
        n=$(NF-1); v=$NF; emit(n, v); next;
      }
      n=split(line, parts, ";");
      for (i=1;i<=n;i++) {
        p=parts[i]; sub(/^[ \t]+/,"",p); sub(/[ \t]+$/,"",p);
        eq=index(p,"=");
        if (eq>1) emit(substr(p,1,eq-1), substr(p,eq+1));
      }
    }')"
  [ -n "$pairs" ] || return 1
  pairs="$(printf '%s' "$pairs" | sed 's/,$//')"
  printf '{"%s": {%s}}\n' "$(printf '%s' "$url" | sed 's/\\/\\\\/g; s/"/\\"/g')" "$pairs" > "$tmp" && \
    mv "$tmp" "$cfile" && chmod 600 "$cfile"
}

start_service() {
  config_load openflux

  local enabled mode transport url transports negotiate debug keyfile cookie cookies_paste
  config_get enabled main enabled 0
  [ "$enabled" = "1" ] || return 1

  config_get mode      main mode l4
  config_get transport main transport yandex
  config_get url       main url ""
  config_get transports main transports ""
  config_get negotiate main negotiate 1
  config_get debug     main debug 1
  config_get keyfile   main encryption_key_file /etc/openflux/secret.txt
  config_get cookie    main cookie_store /tmp/cookies-yandex.json
  config_get cookies_paste main cookies_paste ""

  [ -n "$url" ] || { logger -t openflux "URL is empty, not starting"; return 1; }
  [ -x "$BIN" ] || { logger -t openflux "$BIN not found"; return 1; }
  mkdir -p /etc/openflux
  [ -f "$keyfile" ] || { logger -t openflux "secret $keyfile missing"; return 1; }
  chmod 600 "$keyfile" 2>/dev/null

  # Куки из UI (cookies_paste) -> cookie-store JSON {"<url>": {name: value}}.
  # Форматы: JSON {"a":"b"}, "a=b; c=d", построчно a=b, Netscape cookies.txt.
  if [ -n "$cookies_paste" ]; then
    openflux_write_cookies "$url" "$cookie" "$cookies_paste" && \
      logger -t openflux "cookies_paste applied to $cookie" || \
      logger -t openflux "cookies_paste parse failed, keeping old $cookie"
  fi

  local dbgflag=""
  case "$debug" in
    1) dbgflag="-d" ;;
    2) dbgflag="-dd" ;;
    3) dbgflag="-ddd" ;;
  esac

  procd_open_instance openflux
  procd_set_param command "$BIN" --role=exit --mode="$mode"
  [ -n "$transports" ] && procd_append_param command --transports="$transports"
  [ -z "$transports" ] && procd_append_param command --transport="$transport"
  procd_append_param command --url="$url"
  procd_append_param command --encryption-key-file="$keyfile"
  procd_append_param command --cookie-store="$cookie"
  [ "$negotiate" = "1" ] && procd_append_param command --negotiate
  [ -n "$dbgflag" ] && procd_append_param command "$dbgflag"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  stop
  start
}
